# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token

# Рекомендуется: Telegram ID через запятую (свой ID можно узнать у @userinfobot).
# Тогда пользоваться ботом сможете только вы, а клиенты всё равно смогут открывать
# ссылки на папки, которыми вы поделились. Если оставить пустым — ботом сможет пользоваться любой.
ALLOWED_USERS=

# Необязательно: путь к файлу базы данных
DB_PATH=vault.db
